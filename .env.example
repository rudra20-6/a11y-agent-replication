# Copy to .env and fill in. .env is git-ignored; never commit it.

# OpenRouter key (openrouter.ai/keys). All runs in the paper used OpenRouter's paid route.
OPENROUTER_API_KEY=

# The model every role uses (planner, validator, reference agent, P1-P3, verifier, stall judge).
# Gemma runs:   gemma-4-26b-a4b-it
# Mistral runs: mistral-small-3.2-24b-instruct
A11Y_NAV_MODEL=gemma-4-26b-a4b-it
A11Y_PLANNER_MODEL=gemma-4-26b-a4b-it
A11Y_JUDGE_MODEL=gemma-4-26b-a4b-it
A11Y_VALIDATOR_MODEL=gemma-4-26b-a4b-it

# Paid route only, so every call in a run goes to the same endpoint.
A11Y_OPENROUTER_PAID=1
A11Y_KEYS=openrouter
A11Y_RPM_OPENROUTER=120
# Optional: pin one OpenRouter provider (its slug) for the whole run.
# A11Y_OPENROUTER_PROVIDER=
# Send text inside a content-parts list (needed by some providers; used for the Mistral runs).
# A11Y_TEXT_AS_PARTS=1

# Keep a screenshot of every agent step in runs/<run>/live (used for the Mistral runs).
# A11Y_KEEP_SHOTS=1
